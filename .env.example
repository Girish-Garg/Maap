# Supabase — from your project's API settings (Project Settings → API Keys).
# Copy this file to .env.local and fill in both values. The publishable key is
# safe to ship to the browser; never put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Current Supabase projects show a "Publishable key" (sb_publishable_...).
# Older projects show an "anon public" key — either works; set whichever you have.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
