# Copy to .env and fill in. Never commit .env / .env.local.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL, accessed through Prisma. For local development this is the
# container from docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL="postgresql://maap:maap_password@localhost:5432/maap"

# When Maap itself runs inside Docker Compose, the host is the service name,
# not localhost (docker-compose.yml sets this for the app container already):
# DATABASE_URL="postgresql://maap:maap_password@postgres:5432/maap"
#
# On the VPS, point it at the existing shared Postgres container and Maap's own
# database - set this in the VPS .env, never here:
# DATABASE_URL="postgresql://maap:<password>@shared-postgres:5432/maap"

# Optional: override the local Postgres container's credentials and host port.
# Defaults match the DATABASE_URL above.
# POSTGRES_USER=maap
# POSTGRES_PASSWORD=maap_password
# POSTGRES_DB=maap
# POSTGRES_PORT=5432
# APP_PORT=3000

# ── Authentication (Auth.js) ────────────────────────────────────────────────
# Signs the session cookie. Required. Generate one with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The public origin, used to build OAuth callback URLs. Required in production
# (behind a proxy Auth.js cannot infer it); optional locally.
# AUTH_URL=https://maap.example.com

# Google sign-in. Optional: leave both blank and the Google button is hidden,
# with email + password still working. From Google Cloud Console ->
# APIs & Services -> Credentials -> OAuth client ID (Web application). Add this
# authorised redirect URI, matching your origin:
#   http://localhost:3000/api/auth/callback/google
#   https://maap.example.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Logo storage (OCI Object Storage) ───────────────────────────────────────
# Optional: leave blank and everything works except uploading a business logo.
# Server-side only - the browser never receives these, and never talks to the
# bucket. Logos are served by /api/logo, so the bucket stays private.
#
# Reached over OCI's S3-compatible endpoint. Credentials are a Customer Secret
# Key: OCI Console -> your user -> Customer Secret Keys -> Generate. The secret
# is shown once.
#
# OCI_NAMESPACE is the Object Storage namespace (Bucket details -> Namespace).
# OCI_BUCKET=maap-or-your-shared-bucket
# OCI_NAMESPACE=
# OCI_REGION=ap-mumbai-1
# OCI_ACCESS_KEY_ID=
# OCI_SECRET_ACCESS_KEY=

# The folder this project owns inside the bucket. The bucket is shared with
# other projects, so every object Maap writes lives under "<prefix>/<user_id>/"
# and nothing outside that prefix is ever read, written, or deleted.
# OCI_PREFIX=maap

# Override the endpoint instead of deriving it from namespace + region. Only
# needed to point at a different S3 provider.
# OCI_S3_ENDPOINT=
