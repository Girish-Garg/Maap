# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# build caches
.turbo/
.swc/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# editors
.vscode/
.idea/
*.swp
*.swo
*~

# misc
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# local env files
# Everything except the template: .env holds DATABASE_URL, AUTH_SECRET, the
# Google client secret, and the object storage keys. The pattern also covers
# .env.local, .env.production and any .env.backup-* left behind by an edit.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# The generated client lives in node_modules (already ignored above), so there
# is nothing to add here. prisma/schema.prisma and prisma/migrations/ are part
# of the source and MUST stay committed - `prisma migrate deploy` replays those
# files on the VPS, and an ignored migration is a deploy that cannot run.

# Claude / preview session files (project preview config + local permissions)
/.claude/
